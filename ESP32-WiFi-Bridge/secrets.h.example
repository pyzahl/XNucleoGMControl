// Copy to secrets.h (git-ignored) and fill in your home WiFi.
// Leave HOME_SSID "" to always run the GM-K150 access point instead.

#define HOME_SSID  "your-wifi-name"
#define HOME_PASS  "your-wifi-password"

// Optional fixed address (otherwise DHCP -- then best make a DHCP reservation
// in the router for the ESP32's MAC). Comma separated, not dotted:
